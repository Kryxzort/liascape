+static bool spawned_by_us(int pid) {
+  char path[64];
+  snprintf(path, sizeof(path), "/proc/%d/environ", pid);
+  FILE *f = fopen(path, "r");
+  if (!f) {
+    return false;
+  }
+  size_t cap = 262144;
+  char *env = malloc(cap);
+  if (!env) {
+    fclose(f);
+    return false;
+  }
+  size_t n = fread(env, 1, cap - 1, f);
+  fclose(f);
+  env[n] = '\0';
+  char needle[64];
+  int len = snprintf(needle, sizeof(needle), "WALLPIPER_GUARDIAN_PID=%d",
+                     (int)getpid());
+  for (size_t i = 0; i < n;) {
+    if (strncmp(env + i, needle, (size_t)len) == 0 && env[i + len] == '\0') {
+      free(env);
+      return true;
+    }
+    i += strlen(env + i) + 1;
+  }
+  free(env);
+  return false;
+}
