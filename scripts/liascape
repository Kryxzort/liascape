#!/usr/bin/env bash
# liascape — the one command users type. Installed as <prefix>/bin/liascape by every package (install.sh,
# the PKGBUILD and the AppImage through it, the Nix flake); it finds everything relative to itself:
#
#   <prefix>/bin/liascape                          this launcher
#   <prefix>/libexec/liascape/liascape-backend     the C# backend: serve (the app's API) and the CLI
#   <prefix>/libexec/liascape/liascape-player      the Rust compositor (`liascape ctl …` talks to it)
#   <prefix>/libexec/liascape/liascape-scene-worker  one per Wallpaper Engine scene (the player starts them)
#   <prefix>/lib/liascape/{ui,shell,transitions}   the React UI, the Electron shell, the effect catalogue
#   (Arch's package puts the internal executables in lib/liascape/ itself: its guidelines rule out /usr/libexec)
#
#   liascape                 open the app (Electron: $LIASCAPE_ELECTRON, else `electron45`, else `electron` on PATH)
#   liascape ctl <verb> …    the running player's control socket (state, logs, probe, …)
#   liascape <command> …     everything else goes to the backend (`liascape help` lists it)
#
# Any LIASCAPE_* variable already set wins (dev trees, tests).
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
prefix="$(cd "$(dirname "$self")/.." && pwd -P)"
lib="$prefix/lib/liascape"
libexec="$prefix/libexec/liascape"
[ -e "$libexec/liascape-backend" ] || [ ! -e "$lib/liascape-backend" ] || libexec="$lib"

# the command an autostart entry runs ("Start with your desktop", src/backend/Helpers/Autostart.cs): bin/liascape of this
# prefix, which under Nix is the wrapper around this file (the AppImage's own path wins there, from $APPIMAGE)
export LIASCAPE_LAUNCHER="${LIASCAPE_LAUNCHER:-$prefix/bin/liascape}"
export LIASCAPE_UI_DIR="${LIASCAPE_UI_DIR:-$lib/ui}"
export LIASCAPE_TRANSITIONS_DIR="${LIASCAPE_TRANSITIONS_DIR:-$lib/transitions}"
export LIASCAPE_BACKEND="${LIASCAPE_BACKEND:-$libexec/liascape-backend}"
# only point at the executables that are there: the backend reports a missing one (and a --no-scenes build's worker
# plays test scenes only)
for helper in player:PLAYER scene-worker:SCENE_WORKER; do
  var="LIASCAPE_${helper#*:}_BIN"
  [ -z "${!var:-}" ] && [ -x "$libexec/liascape-${helper%%:*}" ] && export "$var=$libexec/liascape-${helper%%:*}"
done

case "${1-}" in
  "")
    # No core dumps from the window: where systemd-coredump takes them, a crashed renderer stays alive while its core
    # is written (a minute or more), and only then does the shell hear it died and reload the page
    # (app/shell/renderer-recovery.js). Soft limit only, so a process that wants dumps can raise it back; it reaches
    # what the shell starts too (its own backend and player when no other backend runs).
    ulimit -S -c 0
    # electron45 first: distros that carry several majors name each one (Arch's AUR electron45-bin), and a plain
    # `electron` may be another major (.claude/rules/build-and-packaging.md § Electron)
    electron="${LIASCAPE_ELECTRON:-}"
    [ -n "$electron" ] || { command -v electron45 >/dev/null 2>&1 && electron=electron45; } || electron=electron
    exec "$electron" "$lib/shell" ;;
  ctl)
    shift
    [ -n "${LIASCAPE_PLAYER_BIN:-}" ] || { echo "liascape ctl: no liascape-player in $libexec" >&2; exit 1; }
    exec "$LIASCAPE_PLAYER_BIN" ctl "$@" ;;
  *)
    exec "$LIASCAPE_BACKEND" "$@" ;;
esac
