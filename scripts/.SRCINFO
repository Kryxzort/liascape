pkgbase = liascape-git
	pkgdesc = Live wallpaper manager for Wayland (video + Wallpaper Engine scenes)
	pkgver = r1.0000000
	pkgrel = 1
	url = https://github.com/Kryxzort/liascape
	arch = x86_64
	license = GPL-3.0-only
	license = MIT
	makedepends = git
	makedepends = dotnet-sdk
	makedepends = nodejs
	makedepends = npm
	makedepends = rust
	makedepends = clang
	makedepends = cmake
	makedepends = pkgconf
	makedepends = wayland-protocols
	makedepends = glm
	depends = electron45
	depends = mpv
	depends = ffmpeg
	depends = libpipewire
	depends = libpulse
	depends = wayland
	depends = libglvnd
	depends = libxkbcommon
	depends = sdl2
	depends = freetype2
	depends = fontconfig
	depends = harfbuzz
	depends = lz4
	depends = zlib
	depends = libsecret
	depends = gcc-libs
	depends = glibc
	optdepends = mpvpaper: video wallpapers under the legacy engine (AUR)
	optdepends = linux-wallpaperengine: Wallpaper Engine scenes under the legacy engine (AUR)
	optdepends = playerctl: MPRIS-aware auto-mute
	optdepends = steamcmd: Steam Workshop downloads (AUR)
	optdepends = xdg-utils: open a wallpaper in your default app
	optdepends = nvidia-utils: NVDEC decoding and the scene VRAM budget on NVIDIA
	provides = liascape
	conflicts = liascape
	options = !strip
	options = !debug
	source = liascape-git::git+https://github.com/Kryxzort/liascape.git
	sha256sums = SKIP

pkgname = liascape-git
