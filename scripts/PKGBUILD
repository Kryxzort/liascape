# Maintainer: Kryxzort <virajslko0@gmail.com>
# NOTE: this builds the Electron + React UI over the headless C# backend (the current rewrite),
# NOT the old single-binary app. It delegates the whole build to scripts/install.sh so packaging
# never drifts from the canonical build. Regenerate .SRCINFO with `makepkg --printsrcinfo > .SRCINFO`
# after editing.
pkgname=livepaper-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Live wallpaper manager for Wayland (video + Wallpaper Engine scenes) — Electron/React + C# backend"
arch=('x86_64')
url="https://github.com/Kryxzort/livepaper-pro"
license=('MIT')
# Runtime: backend is published --self-contained (bundles .NET) so no dotnet-runtime needed.
depends=('mpvpaper' 'mpv' 'ffmpeg' 'libpulse' 'wl-clipboard' 'electron')
# Build: .NET SDK + Node for the app; C toolchain + wayland/EGL/mpv/pulse headers for lp-transition/lp-audio.
makedepends=('git' 'dotnet-sdk' 'nodejs' 'npm' 'base-devel' 'wayland' 'wayland-protocols' 'libglvnd')
optdepends=('linux-wallpaperengine: Wallpaper Engine scene support'
            'playerctl: MPRIS-aware Auto-Mute')
provides=('livepaper')
conflicts=('livepaper')
options=('!strip' '!debug')
source=("$pkgname::git+https://github.com/Kryxzort/livepaper-pro.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$pkgname"
    # Stage the full install into a temp prefix (/usr). The wrappers bake /usr runtime paths;
    # electron is resolved from PATH at runtime (the electron dependency), so nothing is bundled here.
    DESTDIR="$srcdir/pkg-stage" PREFIX=/usr bash scripts/install.sh
}

package() {
    cp -a "$srcdir/pkg-stage/." "$pkgdir/"
}
