 };
 
 struct filter_opts {
diff --git a/video/cuda.c b/video/cuda.c
index 3b7a2d8..5c0a361 100644
--- a/video/cuda.c
+++ b/video/cuda.c
@@ -19,6 +19,7 @@
 #include "options/m_config.h"
 #include "options/options.h"
 
+#include <libavutil/dict.h>
 #include <libavutil/hwcontext.h>
 
 static struct AVBufferRef *cuda_create_standalone(struct mpv_global *global,
@@ -30,9 +31,14 @@ static struct AVBufferRef *cuda_create_standalone(struct mpv_global *global,
     if (opts->cuda_device != -1)
         decode_dev = talloc_asprintf(NULL, "%d", opts->cuda_device);
 
+    AVDictionary *dict = NULL;
+    if (opts->primary_ctx)
+        av_dict_set(&dict, "primary_ctx", "1", 0);
+
     AVBufferRef* ref = NULL;
-    av_hwdevice_ctx_create(&ref, AV_HWDEVICE_TYPE_CUDA, decode_dev, NULL, 0);
+    av_hwdevice_ctx_create(&ref, AV_HWDEVICE_TYPE_CUDA, decode_dev, dict, 0);
 
+    av_dict_free(&dict);
     talloc_free(decode_dev);
     talloc_free(opts);
     return ref;
diff --git a/video/out/hwdec/hwdec_cuda.c b/video/out/hwdec/hwdec_cuda.c
index 1428946..a412759 100644
--- a/video/out/hwdec/hwdec_cuda.c
+++ b/video/out/hwdec/hwdec_cuda.c
@@ -27,6 +27,8 @@
 
 #include "config.h"
 #include "hwdec_cuda.h"
+#include "options/m_config.h"
+#include "options/options.h"
 
 #include <libavutil/hwcontext.h>
 #include <libavutil/hwcontext_cuda.h>
@@ -57,6 +59,56 @@ int check_cu(const struct ra_hwdec *hw, CUresult err, const char *func)
 
 #define CHECK_CU(x) check_cu(hw, (x), #x)
 
+// Get a context on dev and make it current on the calling thread: a new one,
+// or with --cuda-primary-context the device's primary context, which every
+// user of the device in this process shares instead of each paying for its
+// own. Undo with cuda_ctx_release().
+int cuda_ctx_acquire(const struct ra_hwdec *hw, CUcontext *ctx, CUdevice dev)
+{
+    struct cuda_hw_priv *p = hw->priv;
+    CudaFunctions *cu = p->cu;
+    const unsigned int flags = CU_CTX_SCHED_BLOCKING_SYNC;
+
+    if (!p->primary_ctx)
+        return CHECK_CU(cu->cuCtxCreate(ctx, flags, dev));
+
+    unsigned int cur_flags = 0;
+    int active = 0;
+    int ret = CHECK_CU(cu->cuDevicePrimaryCtxGetState(dev, &cur_flags, &active));
+    if (ret < 0)
+        return ret;
+
+    // The flags only affect how the CPU waits for the GPU, so a primary
+    // context someone else already set up differently is still usable.
+    if (cur_flags != flags && cu->cuDevicePrimaryCtxSetFlags(dev, flags) != CUDA_SUCCESS) {
+        MP_VERBOSE(hw, "Using the primary context with flags 0x%x (it is %s)\n",
+                   cur_flags, active ? "active" : "inactive");
+    }
+
+    ret = CHECK_CU(cu->cuDevicePrimaryCtxRetain(ctx, dev));
+    if (ret < 0)
+        return ret;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(*ctx));
+    if (ret < 0) {
+        CHECK_CU(cu->cuDevicePrimaryCtxRelease(dev));
+        *ctx = NULL;
+    }
+    return ret;
+}
+
+void cuda_ctx_release(const struct ra_hwdec *hw, CUcontext ctx, CUdevice dev)
+{
+    struct cuda_hw_priv *p = hw->priv;
+    CudaFunctions *cu = p->cu;
+
+    // A primary context belongs to the device: drop our reference only.
+    if (p->primary_ctx)
+        CHECK_CU(cu->cuDevicePrimaryCtxRelease(dev));
+    else
+        CHECK_CU(cu->cuCtxDestroy(ctx));
+}
+
 static const struct cuda_interop_fn *interop_fns[] = {
 #if HAVE_GL
     &cuda_gl_fn,
@@ -77,6 +129,10 @@ static int cuda_init(struct ra_hwdec *hw)
     int level = hw->probing ? MSGL_V : MSGL_ERR;
     bool initialized = false;
 
+    struct cuda_opts *opts = mp_get_config_group(NULL, hw->global, &cuda_conf);
+    p->primary_ctx = opts->primary_ctx;
+    talloc_free(opts);
+
     // Initialise CUDA context from backend.
     // Note that the interop check doesn't require the CUDA backend to be initialized.
     // This is important because cuInit wakes up the dgpu (even if the cuda hwdec won't be used!)
@@ -154,10 +210,10 @@ static void cuda_uninit(struct ra_hwdec *hw)
     av_buffer_unref(&p->hwctx.av_device_ref);
 
     if (p->decode_ctx && p->decode_ctx != p->display_ctx)
-        CHECK_CU(cu->cuCtxDestroy(p->decode_ctx));
+        cuda_ctx_release(hw, p->decode_ctx, p->decode_dev);
 
     if (p->display_ctx)
-        CHECK_CU(cu->cuCtxDestroy(p->display_ctx));
+        cuda_ctx_release(hw, p->display_ctx, p->display_dev);
 
     cuda_free_functions(&p->cu);
 }
diff --git a/video/out/hwdec/hwdec_cuda.h b/video/out/hwdec/hwdec_cuda.h
index 6e671b3..98ff2ee 100644
--- a/video/out/hwdec/hwdec_cuda.h
+++ b/video/out/hwdec/hwdec_cuda.h
@@ -28,6 +28,12 @@ struct cuda_hw_priv {
     CudaFunctions *cu;
     CUcontext display_ctx;
     CUcontext decode_ctx;
+    CUdevice display_dev;
+    CUdevice decode_dev;
+
+    // Are display_ctx and decode_ctx their devices' primary contexts
+    // (--cuda-primary-context), retained rather than created
+    bool primary_ctx;
 
     // Do we need to do a full CPU sync after copying
     bool do_full_sync;
@@ -60,3 +66,6 @@ extern struct cuda_interop_fn cuda_gl_fn;
 extern struct cuda_interop_fn cuda_vk_fn;
 
 int check_cu(const struct ra_hwdec *hw, CUresult err, const char *func);
+
+int cuda_ctx_acquire(const struct ra_hwdec *hw, CUcontext *ctx, CUdevice dev);
+void cuda_ctx_release(const struct ra_hwdec *hw, CUcontext ctx, CUdevice dev);
diff --git a/video/out/hwdec/hwdec_cuda_gl.c b/video/out/hwdec/hwdec_cuda_gl.c
index 4c25352..103fdd0 100644
--- a/video/out/hwdec/hwdec_cuda_gl.c
+++ b/video/out/hwdec/hwdec_cuda_gl.c
@@ -130,12 +130,12 @@ static bool cuda_gl_init(const struct ra_hwdec *hw) {
     if (ret < 0)
         return false;
 
-    ret = CHECK_CU(cu->cuCtxCreate(&p->display_ctx, CU_CTX_SCHED_BLOCKING_SYNC,
-                                   display_dev));
-    if (ret < 0)
+    p->display_dev = display_dev;
+    if (cuda_ctx_acquire(hw, &p->display_ctx, display_dev) < 0)
         return false;
 
     p->decode_ctx = p->display_ctx;
+    p->decode_dev = display_dev;
 
     struct cuda_opts *opts = mp_get_config_group(NULL, hw->global, &cuda_conf);
     int decode_dev_idx = opts->cuda_device;
@@ -158,9 +158,8 @@ static bool cuda_gl_init(const struct ra_hwdec *hw) {
             if (ret < 0)
                 return false;
 
-            ret = CHECK_CU(cu->cuCtxCreate(&p->decode_ctx, CU_CTX_SCHED_BLOCKING_SYNC,
-                                           decode_dev));
-            if (ret < 0)
+            p->decode_dev = decode_dev;
+            if (cuda_ctx_acquire(hw, &p->decode_ctx, decode_dev) < 0)
                 return false;
         }
     }
diff --git a/video/out/hwdec/hwdec_cuda_vk.c b/video/out/hwdec/hwdec_cuda_vk.c
index e744ff6..02a09de 100644
--- a/video/out/hwdec/hwdec_cuda_vk.c
+++ b/video/out/hwdec/hwdec_cuda_vk.c
@@ -331,12 +331,12 @@ static bool cuda_vk_init(const struct ra_hwdec *hw) {
         return false;
     }
 
-    ret = CHECK_CU(cu->cuCtxCreate(&p->display_ctx, CU_CTX_SCHED_BLOCKING_SYNC,
-                                   display_dev));
-    if (ret < 0)
+    p->display_dev = display_dev;
+    if (cuda_ctx_acquire(hw, &p->display_ctx, display_dev) < 0)
         return false;
 
     p->decode_ctx = p->display_ctx;
+    p->decode_dev = display_dev;
 
     p->ext_init = cuda_ext_vk_init;
     p->ext_uninit = cuda_ext_vk_uninit;
-- 
