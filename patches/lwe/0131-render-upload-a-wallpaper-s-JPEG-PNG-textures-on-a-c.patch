diff --git a/src/core/WallpaperEngine/Render/TextureUploads.cpp b/src/core/WallpaperEngine/Render/TextureUploads.cpp
new file mode 100644
index 0000000..6f1f66a
--- /dev/null
+++ b/src/core/WallpaperEngine/Render/TextureUploads.cpp
@@ -0,0 +1,88 @@
+#include "TextureUploads.h"
+
+#include "WallpaperEngine/Context.h"
+
+#include <pthread.h>
+
+using namespace WallpaperEngine::Render;
+
+TextureUploads* TextureUploads::of (const Context& context, size_t bytes) {
+    if (context.gl_upload_context == nullptr || context.gl_upload_context->make_current == nullptr) {
+	return nullptr;
+    }
+    context.deferred_upload_bytes += bytes;
+    if (context.texture_uploads == nullptr) {
+	if (context.deferred_upload_bytes < kStartBytes) {
+	    return nullptr;
+	}
+	context.texture_uploads = std::make_unique<TextureUploads> (*context.gl_upload_context);
+    }
+    return context.texture_uploads.get ();
+}
+
+TextureUploads::TextureUploads (wp_gl_upload_context& host) : m_host (host) {
+    this->m_thread = std::thread (&TextureUploads::run, this);
+}
+
+TextureUploads::~TextureUploads () {
+    {
+	std::lock_guard lock (this->m_mutex);
+	this->m_stop = true;
+    }
+    this->m_wake.notify_one ();
+    this->m_thread.join ();
+}
+
+GLsync TextureUploads::upload (GLuint texture, GLint level, int w, int h, const unsigned char* pixels) {
+    std::packaged_task<GLsync ()> job ([texture, level, w, h, pixels] {
+	glBindTexture (GL_TEXTURE_2D, texture);
+	glTexImage2D (GL_TEXTURE_2D, level, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	glBindTexture (GL_TEXTURE_2D, 0);
+	GLsync fence = glFenceSync (GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+	// the render thread's glWaitSync needs the fence submitted
+	glFlush ();
+	return fence;
+    });
+    auto done = job.get_future ();
+    {
+	std::lock_guard lock (this->m_mutex);
+	if (this->m_failed || this->m_stop) {
+	    return nullptr;
+	}
+	this->m_jobs.push_back (std::move (job));
+    }
+    this->m_wake.notify_one ();
+    try {
+	return done.get ();
+    } catch (const std::future_error&) {
+	// queued before the thread found it has no context: dropped unrun
+	return nullptr;
+    }
+}
+
+void TextureUploads::run () {
+    pthread_setname_np (pthread_self (), "wp-tex-upload");
+    const bool current = this->m_host.make_current (this->m_host.user_parameter);
+    for (;;) {
+	std::packaged_task<GLsync ()> job;
+	{
+	    std::unique_lock lock (this->m_mutex);
+	    if (!current) {
+		this->m_failed = true;
+	    }
+	    this->m_wake.wait (lock, [this] { return this->m_stop || !this->m_jobs.empty (); });
+	    if (this->m_jobs.empty ()) {
+		break;
+	    }
+	    job = std::move (this->m_jobs.front ());
+	    this->m_jobs.pop_front ();
+	}
+	if (current) {
+	    job ();
+	}
+	// else: dropped unrun, its upload () answers null
+    }
+    if (current && this->m_host.release != nullptr) {
+	this->m_host.release (this->m_host.user_parameter);
+    }
+}
diff --git a/src/core/WallpaperEngine/Render/TextureUploads.h b/src/core/WallpaperEngine/Render/TextureUploads.h
new file mode 100644
index 0000000..89dca36
--- /dev/null
+++ b/src/core/WallpaperEngine/Render/TextureUploads.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <glad/glad.h>
+
+#include <condition_variable>
+#include <cstddef>
+#include <deque>
+#include <future>
+#include <mutex>
+#include <thread>
+
+#include "linux-wallpaperengine/context.h"
+
+namespace WallpaperEngine {
+class Context;
+}
+
+namespace WallpaperEngine::Render {
+/**
+ * The thread deferred JPEG / PNG textures upload on, current on the host's upload context
+ * (wp_context_set_gl_upload_context). NVIDIA converts a texture's pixels on the CPU of the thread that calls
+ * glTexImage2D (about 1.6 GB/s, pixel buffer objects slower still), so on the render thread a scene's large images
+ * cost their whole conversion before its first frame; here it runs while the wallpaper builds. One per Context,
+ * started at its first texture and stopped in its destructor, after every texture of the cache is gone
+ */
+class TextureUploads {
+public:
+    /**
+     * The thread starts once a context's deferred images reach this many RGBA8 bytes (~40 ms of conversion); the
+     * ones before it upload on the render thread. Below it the thread costs more than it saves (starting it, its
+     * context, its uploads beside the render thread's own GL calls): measured, a scene whose images convert in ~3 ms
+     * built ~20 ms slower with a thread from the first image, and scenes with 30-60 MB of images 0-50 ms slower
+     */
+    static constexpr size_t kStartBytes = 64u << 20;
+
+    /**
+     * The context's upload thread for an image of `bytes` (RGBA8), started on the render thread once the context's
+     * deferred images reach kStartBytes; null: not yet, or the host gave no upload context
+     */
+    static TextureUploads* of (const Context& context, size_t bytes);
+
+    explicit TextureUploads (wp_gl_upload_context& host);
+    ~TextureUploads ();
+
+    /**
+     * From any thread: uploads `w` × `h` RGBA8 `pixels` into `level` of `texture` and waits for it. Returns the fence
+     * after the upload (the render thread waits on it with glWaitSync, then re-binds the texture), or null: no upload
+     * context (make_current failed), and the caller uploads on the render thread
+     */
+    GLsync upload (GLuint texture, GLint level, int w, int h, const unsigned char* pixels);
+
+private:
+    void run ();
+
+    wp_gl_upload_context& m_host;
+    std::mutex m_mutex;
+    std::condition_variable m_wake;
+    std::deque<std::packaged_task<GLsync ()>> m_jobs;
+    /** make_current failed: every upload is the render thread's */
+    bool m_failed = false;
+    bool m_stop = false;
+    std::thread m_thread;
+};
+} // namespace WallpaperEngine::Render
