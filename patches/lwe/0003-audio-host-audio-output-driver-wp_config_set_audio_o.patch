diff --git a/include/linux-wallpaperengine/configuration.h b/include/linux-wallpaperengine/configuration.h
index f011be8..3af86d3 100644
--- a/include/linux-wallpaperengine/configuration.h
+++ b/include/linux-wallpaperengine/configuration.h
@@ -41,6 +41,17 @@ struct wp_rendering_pause_check {
     bool (*is_paused) (void* user_parameter);
 };
 
+/**
+ * Audio output owned by the host (see wp_config_set_audio_output). The host pulls F32 interleaved
+ * samples at this rate and channel count with wp_context_audio_pull.
+ */
+typedef struct wp_audio_output {
+    /** samples per second per channel (8000..192000) */
+    int sample_rate;
+    /** 1 (mono) or 2 (stereo, interleaved L R) */
+    int channels;
+} wp_audio_output;
+
 /**
  * Allocates and sets up some sensible defaults for the renderer
  *
@@ -106,6 +117,17 @@ WPENGINE_API bool wp_config_detect_steam_dir (wp_configuration* config);
  */
 WPENGINE_API void wp_config_enable_audio (wp_configuration* config, bool enable);
 
+/**
+ * Makes contexts created from this configuration hand their audio to the host instead of opening
+ * an SDL audio device: no device, no SDL audio subsystem; the host pulls the unity-gain mix of every
+ * stream with wp_context_audio_pull and applies volume, mute and pause itself
+ * (wp_config_set_audio_volume does not apply to it). Takes effect for contexts created afterwards.
+ *
+ * @param config
+ * @param output The output format the host pulls, NULL to go back to the SDL output (the default)
+ */
+WPENGINE_API void wp_config_set_audio_output (wp_configuration* config, const wp_audio_output* output);
+
 /**
  * Sets the desired background's volume (value ranges from 0 to 128)
  *
diff --git a/include/linux-wallpaperengine/context.h b/include/linux-wallpaperengine/context.h
index 8f42743..5adf65f 100644
--- a/include/linux-wallpaperengine/context.h
+++ b/include/linux-wallpaperengine/context.h
@@ -3,6 +3,8 @@
 
 #define WP_AUDIO_INPUT_FRAME_SIZE 1024
 
+#include <stddef.h>
+
 #include "configuration.h"
 #include "export.h"
 
@@ -117,6 +119,39 @@ WPENGINE_API void wp_context_set_time_counter (wp_context* context, wp_time_coun
  */
 WPENGINE_API void wp_context_set_audio_input_mix (wp_context* context, wp_audio_input_mix* mix);
 
+/**
+ * Pulls the next frames of the context's audio: the unity-gain mix of every playing stream, as F32
+ * interleaved samples in the format given to wp_config_set_audio_output. Never waits for decoding:
+ * whatever is not decoded yet is silence. Call it from the host's audio output (any one thread), and
+ * stop pulling before wp_context_destroy.
+ *
+ * The host controls the rate: frames pulled per second of its own clock = playback speed (pull
+ * faster or slower and time-stretch the result to change speed without changing pitch); not pulling
+ * pauses the sound where it is.
+ *
+ * @param context A context created from a configuration with a host audio output
+ * @param interleaved Room for frames * channels floats
+ * @param frames The number of frames to fill
+ *
+ * @return The frames written (always frames), 0 when the context has no host audio output
+ */
+WPENGINE_API size_t wp_context_audio_pull (wp_context* context, float* interleaved, size_t frames);
+
+/**
+ * @param context
+ *
+ * @return The number of audio streams the context's backgrounds currently play (0 until a scene's
+ * renderer is built by its first wp_render_frame)
+ */
+WPENGINE_API int wp_context_audio_stream_count (wp_context* context);
+
+/**
+ * @param context
+ *
+ * @return "host" when the host pulls the audio (wp_config_set_audio_output), "sdl" otherwise
+ */
+WPENGINE_API const char* wp_context_audio_driver_name (wp_context* context);
+
 #ifdef __cplusplus
 }
 #endif
