diff --git a/src/core/WallpaperEngine/Audio/Drivers/HostAudioDriver.cpp b/src/core/WallpaperEngine/Audio/Drivers/HostAudioDriver.cpp
new file mode 100644
index 0000000..fd35a05
--- /dev/null
+++ b/src/core/WallpaperEngine/Audio/Drivers/HostAudioDriver.cpp
@@ -0,0 +1,123 @@
+#include <algorithm>
+#include <ranges>
+
+#include <SDL.h>
+
+#include "HostAudioDriver.h"
+
+#include "WallpaperEngine/Audio/AudioPlayingDetector.h"
+#include "WallpaperEngine/Context.h"
+
+using namespace WallpaperEngine::Audio;
+using namespace WallpaperEngine::Audio::Drivers;
+
+HostAudioDriver::HostAudioDriver (Context& applicationContext, const int sampleRate, const int channels) :
+    AudioDriver (applicationContext), m_sampleRate (std::clamp (sampleRate, 8000, 192000)),
+    m_channels (std::clamp (channels, 1, 2)) { }
+
+HostAudioDriver::~HostAudioDriver () {
+    std::lock_guard lock (this->m_streamsMutex);
+
+    for (const auto* buffer : this->m_streams | std::views::values) {
+	delete buffer;
+    }
+
+    this->m_streams.clear ();
+}
+
+int HostAudioDriver::addStream (AudioStream* stream) {
+    std::lock_guard lock (this->m_streamsMutex);
+    const int newStreamId = this->m_lastStreamID++;
+
+    this->m_streams.insert_or_assign (newStreamId, new HostAudioBuffer { .stream = stream });
+
+    return newStreamId;
+}
+
+void HostAudioDriver::removeStream (const int streamId) {
+    std::lock_guard lock (this->m_streamsMutex);
+    const auto it = this->m_streams.find (streamId);
+
+    if (it == this->m_streams.end ()) {
+	return;
+    }
+
+    delete it->second;
+    this->m_streams.erase (it);
+}
+
+int HostAudioDriver::streamCount () {
+    std::lock_guard lock (this->m_streamsMutex);
+
+    return static_cast<int> (this->m_streams.size ());
+}
+
+size_t HostAudioDriver::pull (float* out, const size_t frames) {
+    if (out == nullptr || frames == 0) {
+	return 0;
+    }
+
+    const size_t samples = frames * this->m_channels;
+
+    std::fill_n (out, samples, 0.0f);
+
+    // the configuration's mute check pauses every stream, exactly like the SDL driver's callback
+    if (this->getContext ().audio->getDetector ().anythingPlaying ()) {
+	return frames;
+    }
+
+    std::lock_guard lock (this->m_streamsMutex);
+
+    for (auto* buffer : this->m_streams | std::views::values) {
+	if (!buffer->stream->isInitialized ()) {
+	    continue;
+	}
+
+	size_t written = 0;
+
+	while (written < samples && this->getContext ().isRunning) {
+	    if (buffer->index >= buffer->size) {
+		// decodeFrame blocks on an empty packet queue; a pull must never wait for decoding, so an
+		// empty queue is silence for the rest of this pull (and wakes the read thread)
+		if (buffer->stream->isQueueEmpty ()) {
+		    SDL_CondSignal (buffer->stream->getWaitCondition ());
+		    break;
+		}
+
+		const int bytes = buffer->stream->decodeFrame (buffer->data, sizeof (buffer->data));
+
+		buffer->index = 0;
+
+		if (bytes < 0) {
+		    // decode error: a short stretch of silence, like the SDL driver
+		    buffer->size = 256;
+		    std::fill_n (reinterpret_cast<float*> (buffer->data), buffer->size, 0.0f);
+		} else {
+		    buffer->size = std::min (static_cast<size_t> (bytes), sizeof (buffer->data)) / sizeof (float);
+		}
+
+		if (buffer->size == 0) {
+		    break;
+		}
+	    }
+
+	    const auto* source = reinterpret_cast<const float*> (buffer->data) + buffer->index;
+	    const size_t count = std::min (samples - written, buffer->size - buffer->index);
+
+	    for (size_t i = 0; i < count; i++) {
+		out[written + i] += source[i];
+	    }
+
+	    written += count;
+	    buffer->index += count;
+	}
+    }
+
+    return frames;
+}
+
+AVSampleFormat HostAudioDriver::getFormat () const { return AV_SAMPLE_FMT_FLT; }
+
+int HostAudioDriver::getSampleRate () const { return this->m_sampleRate; }
+
+int HostAudioDriver::getChannels () const { return this->m_channels; }
diff --git a/src/core/WallpaperEngine/Audio/Drivers/HostAudioDriver.h b/src/core/WallpaperEngine/Audio/Drivers/HostAudioDriver.h
new file mode 100644
index 0000000..8458157
--- /dev/null
+++ b/src/core/WallpaperEngine/Audio/Drivers/HostAudioDriver.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <cstddef>
+#include <map>
+#include <mutex>
+
+#include "WallpaperEngine/Audio/AudioStream.h"
+#include "WallpaperEngine/Audio/Drivers/AudioDriver.h"
+
+namespace WallpaperEngine::Audio::Drivers {
+/**
+ * Decode state of one stream played through the host driver
+ */
+struct HostAudioBuffer {
+    AudioStream* stream = nullptr;
+    /** decoded F32 interleaved samples; same capacity as the SDL driver's per-stream buffer */
+    alignas (float) uint8_t data[(192000 * 3) / 2] = { 0 };
+    /** valid samples in data */
+    size_t size = 0;
+    /** next sample to mix */
+    size_t index = 0;
+};
+
+/**
+ * Audio driver for embedders that own audio output themselves (wp_config_set_audio_output).
+ *
+ * Opens no device: the host pulls F32 interleaved PCM at the configured rate and channel count with
+ * wp_context_audio_pull, from whatever thread drives its own output (a real-time callback included:
+ * a pull never waits for decoding — what is not decoded yet is silence). Every stream is mixed at
+ * unity gain; volume, ramps, mute and pause are the host's (not pulling = paused: the decode queues
+ * fill and the read threads wait). Because the host decides how many frames it pulls per second it
+ * can also play a scene's sound faster or slower, e.g. through a time-stretch stage of its own.
+ */
+class HostAudioDriver final : public AudioDriver {
+public:
+    HostAudioDriver (Context& applicationContext, int sampleRate, int channels);
+    ~HostAudioDriver () override;
+
+    /** @inheritdoc */
+    int addStream (AudioStream* stream) override;
+    /** @inheritdoc */
+    void removeStream (int streamId) override;
+
+    /** @inheritdoc */
+    [[nodiscard]] AVSampleFormat getFormat () const override;
+    /** @inheritdoc */
+    [[nodiscard]] int getSampleRate () const override;
+    /** @inheritdoc */
+    [[nodiscard]] int getChannels () const override;
+
+    /**
+     * Mixes the next frames of every stream into out (frames * channels floats), silence where
+     * nothing is decoded yet
+     *
+     * @return frames written (always frames, 0 for a null buffer)
+     */
+    size_t pull (float* out, size_t frames);
+
+    /**
+     * @return The number of streams currently registered
+     */
+    [[nodiscard]] int streamCount ();
+
+private:
+    int m_sampleRate;
+    int m_channels;
+    int m_lastStreamID = 0;
+    std::mutex m_streamsMutex;
+    std::map<int, HostAudioBuffer*> m_streams {};
+};
+} // namespace WallpaperEngine::Audio::Drivers
