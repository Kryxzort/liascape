From f21c79ffa8fc9682f4c5df88e9a2b3a7cf839341 Mon Sep 17 00:00:00 2001
From: Kryxzort <virajslko@gmail.com>
Date: Tue, 27 Oct 2026 20:53:05 +0530
Subject: [PATCH 05/17] scripting: run engine timers on the host's clock
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

engine.setTimeout / engine.setInterval scheduled against
std::chrono::steady_clock, while everything else a scene does — animation,
particles, engine.runtime, engine.frametime — follows the host's
wp_time_counter. A host that pauses (holds its clock) or steps time
deterministically saw scripted timers keep firing on the wall clock.

Timers now schedule in seconds of the context's renderTime, the value
engine.runtime reports. When the host's clock goes back (a seek), a timer
due further away than its own duration restarts from the new time instead
of stalling until the clock catches up.

Origin: ours
Why: lp-player's pause freezes a scene's clock and must freeze everything in it (invariant #7: pause freezes time; docs/player/spikes/lwe-core.md §4.2)
Status: candidate-for-upstream
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Scripting/EngineObject.cpp                | 24 ++++++++++++-------
 .../WallpaperEngine/Scripting/EngineObject.h  | 12 +++++++---
 2 files changed, 25 insertions(+), 11 deletions(-)

diff --git a/src/core/WallpaperEngine/Scripting/EngineObject.cpp b/src/core/WallpaperEngine/Scripting/EngineObject.cpp
index bd5dec3..dec5d97 100644
--- a/src/core/WallpaperEngine/Scripting/EngineObject.cpp
+++ b/src/core/WallpaperEngine/Scripting/EngineObject.cpp
@@ -237,23 +237,22 @@ EngineObject::~EngineObject () {
     JS_FreeValue (this->m_engine.getContext (), this->m_instance);
 }
 
+double EngineObject::now () const { return this->m_scene.getContext ().getContext ().renderTime; }
+
 uint32_t EngineObject::reserveNextTimeoutId (JSValue function, uint64_t duration) {
     const auto id = ++this->m_nextTimeoutId;
+    const double seconds = static_cast<double> (duration) / 1000.0;
 
-    this->m_timeouts[id] = Timeout { .callback = function,
-				     .duration = std::chrono::milliseconds (duration),
-				     .next = std::chrono::steady_clock::now () + std::chrono::milliseconds (duration) };
+    this->m_timeouts[id] = Timeout { .callback = function, .duration = seconds, .next = this->now () + seconds };
 
     return id;
 }
 
 uint32_t EngineObject::reserveNextIntervalId (JSValue function, uint64_t duration) {
     const auto id = ++this->m_nextIntervalId;
+    const double seconds = static_cast<double> (duration) / 1000.0;
 
-    this->m_intervals[id]
-	= Timeout { .callback = function,
-		    .duration = std::chrono::milliseconds (duration),
-		    .next = std::chrono::steady_clock::now () + std::chrono::milliseconds (duration) };
+    this->m_intervals[id] = Timeout { .callback = function, .duration = seconds, .next = this->now () + seconds };
 
     return id;
 }
@@ -283,10 +282,15 @@ void EngineObject::clearTimeout (uint32_t id) {
 }
 
 void EngineObject::tick () {
-    const auto now = std::chrono::steady_clock::now ();
+    const double now = this->now ();
 
     // check any interval and run them if needed
     for (auto& timeout : this->m_intervals | std::views::values) {
+	// the host's clock went back (a seek): restart the interval from here instead of stalling
+	if (timeout.next - now > timeout.duration) {
+	    timeout.next = now + timeout.duration;
+	}
+
 	if (timeout.next > now) {
 	    continue;
 	}
@@ -300,6 +304,10 @@ void EngineObject::tick () {
 
     // check any timeout and run them if needed
     for (auto& [id, timeout] : this->m_timeouts) {
+	if (timeout.next - now > timeout.duration) {
+	    timeout.next = now + timeout.duration;
+	}
+
 	if (timeout.next > now) {
 	    continue;
 	}
diff --git a/src/core/WallpaperEngine/Scripting/EngineObject.h b/src/core/WallpaperEngine/Scripting/EngineObject.h
index 521a2ff..4c2ba53 100644
--- a/src/core/WallpaperEngine/Scripting/EngineObject.h
+++ b/src/core/WallpaperEngine/Scripting/EngineObject.h
@@ -1,7 +1,6 @@
 #pragma once
 #include "quickjs.h"
 
-#include <chrono>
 #include <map>
 
 namespace WallpaperEngine::Render::Wallpapers {
@@ -26,12 +25,19 @@ public:
     void tick ();
 
 protected:
+    /**
+     * Timers run on the scene's clock (the host's wp_time_counter, in seconds), not the wall clock:
+     * a host that pauses or steps time pauses or steps them too
+     */
     struct Timeout {
 	JSValue callback;
-	std::chrono::milliseconds duration;
-	std::chrono::steady_clock::time_point next;
+	double duration;
+	double next;
     };
 
+    /** @return The scene's current time in seconds (what engine.runtime reports) */
+    [[nodiscard]] double now () const;
+
     uint32_t m_nextTimeoutId = 0;
     uint32_t m_nextIntervalId = 0;
     std::map<uint32_t, Timeout> m_intervals;
