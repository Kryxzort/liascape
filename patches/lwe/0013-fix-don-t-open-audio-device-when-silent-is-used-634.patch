From cc090fa8490d16f3f37379dd1f14175065b66c6a Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Wed, 28 Oct 2026 05:36:19 +0300
Subject: [PATCH 13/17] fix: don't open audio device when --silent is used
 (#634)

(cherry picked from commit 1a856e80a083a8c4b07c9c4e3e537c450e0a6062)

[livepaper: next-v2's driver gets the core's Context: settings.audio.enabled -> config.enableAudio (wp_config_enable_audio)]

Origin: upstream-PR
Upstream-PR: https://github.com/Almamu/linux-wallpaperengine/pull/634
Adapted-by: livepaper
Why: an SDL context with audio disabled must not open a device (lp-player uses the host driver; kept in step with upstream)
Status: upstream: merged on Almamu/linux-wallpaperengine main 2026-10-28, not (yet) on next-v2
---
 src/core/WallpaperEngine/Audio/Drivers/SDLAudioDriver.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/core/WallpaperEngine/Audio/Drivers/SDLAudioDriver.cpp b/src/core/WallpaperEngine/Audio/Drivers/SDLAudioDriver.cpp
index 4e7b863..c780b53 100644
--- a/src/core/WallpaperEngine/Audio/Drivers/SDLAudioDriver.cpp
+++ b/src/core/WallpaperEngine/Audio/Drivers/SDLAudioDriver.cpp
@@ -81,6 +81,11 @@ void audio_callback (void* userdata, uint8_t* streamData, int length) {
 SDLAudioDriver::SDLAudioDriver (Context& applicationContext) : AudioDriver (applicationContext), m_audioSpec () {
     this->m_streamListMutex = SDL_CreateMutex ();
 
+    if (!applicationContext.config.enableAudio) {
+	sLog.out ("Audio is disabled, not opening any audio device");
+	return;
+    }
+
     if (SDL_InitSubSystem (SDL_INIT_AUDIO) < 0) {
 	sLog.error ("Cannot initialize SDL audio system, SDL_GetError: ", SDL_GetError ());
 	sLog.error ("Continuing without audio support");
