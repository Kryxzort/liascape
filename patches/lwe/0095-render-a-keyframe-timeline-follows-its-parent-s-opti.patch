 using namespace WallpaperEngine::Data::JSON;
@@ -8,18 +9,21 @@ using namespace WallpaperEngine::Data::Parsers;
 
 UserSettingUniquePtr JsonExtensions::user (const std::string& key, const Properties& properties) const {
     const auto value = this->require (key, "User setting without default value must be present");
+    const DynamicValueParser::PropertyScope scope (this, key);
 
     return UserSettingParser::parse (value, properties);
 }
 
 UserSettingUniquePtr JsonExtensions::text (const std::string& key, const Properties& properties) const {
     const auto value = this->require (key, "User setting without default value must be present");
+    const DynamicValueParser::PropertyScope scope (this, key);
 
     return UserSettingParser::parse (value, properties, false, true);
 }
 
 UserSettingUniquePtr JsonExtensions::color (const std::string& key, const Properties& properties) const {
     const auto value = this->require (key, "User setting without default value must be present");
+    const DynamicValueParser::PropertyScope scope (this, key);
 
     return UserSettingParser::parse (value, properties, true);
 }
diff --git a/src/core/WallpaperEngine/Data/Model/PropertyAnimation.cpp b/src/core/WallpaperEngine/Data/Model/PropertyAnimation.cpp
index 09a3fe8..456976b 100644
--- a/src/core/WallpaperEngine/Data/Model/PropertyAnimation.cpp
+++ b/src/core/WallpaperEngine/Data/Model/PropertyAnimation.cpp
@@ -176,6 +176,11 @@ std::vector<std::pair<std::string, int>> PropertyAnimation::takeFiredEvents () {
 }
 
 void PropertyAnimation::advance (float dt) {
+    if (this->m_parent != nullptr) {
+	// on the parent's clock (inferred from the editor's parent / children links: the curves share one timeline)
+	this->m_time = std::clamp (this->m_parent->getTime (), 0.0f, this->m_duration);
+	return;
+    }
     if ((this->m_flags & (StartPaused | Finished)) != 0) {
 	return;
     }
diff --git a/src/core/WallpaperEngine/Data/Model/PropertyAnimation.h b/src/core/WallpaperEngine/Data/Model/PropertyAnimation.h
index 65d7ec0..765f234 100644
--- a/src/core/WallpaperEngine/Data/Model/PropertyAnimation.h
+++ b/src/core/WallpaperEngine/Data/Model/PropertyAnimation.h
@@ -89,6 +89,17 @@ public:
     [[nodiscard]] unsigned int getFlags () const;
 
     void setEvents (std::vector<Event> events) { this->m_events = std::move (events); }
+
+    /**
+     * `options.parent.key`: the sibling property (same object, or same effect pass's constants) whose timeline this
+     * one follows; its `options.children` lists them back (1864677589's origins follow their angles, 3163060610's
+     * scripted Radius drives Size and opacity). A child runs on the parent's clock: its time is the parent's
+     * (seconds, held at its own length), so it plays, pauses and restarts with it
+     */
+    [[nodiscard]] const std::string& getParentKey () const { return this->m_parentKey; }
+    void setParentKey (std::string key) { this->m_parentKey = std::move (key); }
+    void setParent (std::shared_ptr<const PropertyAnimation> parent) { this->m_parent = std::move (parent); }
+    [[nodiscard]] bool hasParent () const { return this->m_parent != nullptr; }
     /** The events the timeline passed since the last call (name, frame), in order */
     [[nodiscard]] std::vector<std::pair<std::string, int>> takeFiredEvents ();
 
@@ -107,6 +118,8 @@ private:
     std::vector<Curve> m_curves;
     std::vector<Event> m_events = {};
     std::vector<std::pair<std::string, int>> m_fired = {};
+    std::string m_parentKey;
+    std::shared_ptr<const PropertyAnimation> m_parent;
     /** the time span advance covered last: [from, to] in timeline seconds, forwards (wrapped spans split) */
     void collectEvents (float from, float to);
 };
diff --git a/src/core/WallpaperEngine/Data/Parsers/DynamicValueParser.cpp b/src/core/WallpaperEngine/Data/Parsers/DynamicValueParser.cpp
index 95385e3..38c755c 100644
--- a/src/core/WallpaperEngine/Data/Parsers/DynamicValueParser.cpp
+++ b/src/core/WallpaperEngine/Data/Parsers/DynamicValueParser.cpp
@@ -12,6 +12,9 @@ using namespace WallpaperEngine::Data::Model;
 
 namespace {
 thread_local std::vector<AnimatedValue>* g_animatedValues = nullptr;
+thread_local std::vector<DynamicValueParser::AnimationCollector::Named>* g_named = nullptr;
+thread_local const void* g_scopeOwner = nullptr;
+thread_local const std::string* g_scopeKey = nullptr;
 
 // a `back`/`front` handle: an object, enabled unless `"enabled": false`; a disabled one is (0, 0)
 bool parseHandle (const JSON& key, const char* name, glm::vec2& out) {
@@ -72,11 +75,40 @@ PropertyAnimation::Curve parseCurve (const JSON& keys, float offset) {
 } // namespace
 
 DynamicValueParser::AnimationCollector::AnimationCollector (std::vector<AnimatedValue>& out) :
-    m_previous (g_animatedValues) {
+    m_previous (g_animatedValues), m_previousNamed (g_named) {
     g_animatedValues = &out;
+    g_named = &this->m_named;
 }
 
-DynamicValueParser::AnimationCollector::~AnimationCollector () { g_animatedValues = this->m_previous; }
+DynamicValueParser::AnimationCollector::~AnimationCollector () {
+    g_animatedValues = this->m_previous;
+    g_named = this->m_previousNamed;
+
+    for (const auto& child : this->m_named) {
+	const auto& key = child.animation->getParentKey ();
+	if (key.empty ()) {
+	    continue;
+	}
+	for (const auto& parent : this->m_named) {
+	    if (parent.owner == child.owner && parent.key == key && parent.animation != child.animation
+		&& parent.animation->getParentKey ().empty ()) {
+		child.animation->setParent (parent.animation);
+		break;
+	    }
+	}
+    }
+}
+
+DynamicValueParser::PropertyScope::PropertyScope (const void* owner, const std::string& key) :
+    m_owner (g_scopeOwner), m_key (g_scopeKey) {
+    g_scopeOwner = owner;
+    g_scopeKey = &key;
+}
+
+DynamicValueParser::PropertyScope::~PropertyScope () {
+    g_scopeOwner = this->m_owner;
+    g_scopeKey = this->m_key;
+}
 
 PropertyAnimationSharedPtr DynamicValueParser::parseAnimation (const JSON& animation, const JSON& value) {
     if (!animation.is_object ()) {
@@ -144,6 +176,13 @@ PropertyAnimationSharedPtr DynamicValueParser::parseAnimation (const JSON& anima
 	std::move (curves)
     );
 
+    // `options.parent.key`: the sibling property whose timeline this one follows (linked by AnimationCollector)
+    if (const auto parent = options->find ("parent"); parent != options->end () && parent->is_object ()) {
+	if (const auto key = parent->find ("key"); key != parent->end () && key->is_string ()) {
+	    result->setParentKey (key->get<std::string> ());
+	}
+    }
+
     // `options.events`: [{ frame, name }], SceneScript's animationEvent
     if (const auto events = options->find ("events"); events != options->end () && events->is_array ()) {
 	std::vector<PropertyAnimation::Event> parsed;
@@ -243,6 +282,9 @@ DynamicValueParser::parse (const JSON& data, const Properties& properties, bool
 		if (g_animatedValues != nullptr) {
 		    g_animatedValues->push_back ({ .value = value.get (), .alive = value->getAliveFlag () });
 		}
+		if (g_named != nullptr && g_scopeOwner != nullptr && g_scopeKey != nullptr) {
+		    g_named->push_back ({ .animation = value->getAnimation (), .owner = g_scopeOwner, .key = *g_scopeKey });
+		}
 	    }
 	}
     }
