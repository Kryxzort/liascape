     int octaves = 3;
@@ -186,8 +190,18 @@ struct Remap {
 	}
 	inMin = num (j, "inputrangemin", 0.0f);
 	inMax = num (j, "inputrangemax", 1.0f);
-	outMin = num (j, "outputrangemin", 0.0f);
-	outMax = num (j, "outputrangemax", 1.0f);
+	outMin = vec3 (j, "outputrangemin", glm::vec3 (0.0f));
