+ */
+struct LightData {
+    enum class Kind { Point, Spot, Other };
+    Kind kind = Kind::Point;
+    std::string type;
+    UserSettingUniquePtr color;
+    UserSettingUniquePtr intensity;
+    float radius = 1000.0f;
+    float exponent = 1.0f;
+    float innerCone = 0.0f;
+    float outerCone = 45.0f;
+};
