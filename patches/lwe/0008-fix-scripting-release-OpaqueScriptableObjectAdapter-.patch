From f5fea6aff2335533701c6fe204ab2c7258f05fdf Mon Sep 17 00:00:00 2001
From: David Mireles <davidmirelesll@outlook.com>
Date: Tue, 27 Oct 2026 19:59:20 -0600
Subject: [PATCH 08/21] fix(scripting): release OpaqueScriptableObjectAdapter
 when the JS object is finalized (#619)

ScriptableObjectAdapter::instantiate allocates an OpaqueScriptableObjectAdapter
on the heap and stores it via JS_SetOpaque, but the JSClassDef passed to
JS_NewClass has no finalizer. QuickJS releases the JSValue when the object
is unreachable, leaving the heap struct leaked for the lifetime of the
runtime.

JS_DUMP_LEAKS is enabled on the runtime (ScriptEngine.cpp:199) so this is
observable: every ScriptableObject (the 'ILayer' root object exposed to
scene scripts) reports a leak on shutdown.

Match the pattern used by VectorAdapter::vector_finalizer
(src/WallpaperEngine/Scripting/Adapters/VectorAdapter.cpp:398): a free
function with the standard (JSRuntime*, JSValueConst) signature that
fetches the opaque via JS_GetAnyOpaque, validates the magic, and deletes
the container. Wire it into the JSClassDef in the adapter constructor.

(cherry picked from commit 5da5073466f1aa94e0bd847676dd049398971366)

Origin: upstream-PR
Upstream-PR: https://github.com/Almamu/linux-wallpaperengine/pull/619
Adapted-by: livepaper
Why: every scene script object leaked its adapter for the life of the scene worker
Status: upstream: merged on Almamu/linux-wallpaperengine main 2026-10-28, not (yet) on next-v2
---
 .../Adapters/ScriptableObjectAdapter.cpp          | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/core/WallpaperEngine/Scripting/Adapters/ScriptableObjectAdapter.cpp b/src/core/WallpaperEngine/Scripting/Adapters/ScriptableObjectAdapter.cpp
index 0e6a80c..7ae679c 100644
--- a/src/core/WallpaperEngine/Scripting/Adapters/ScriptableObjectAdapter.cpp
+++ b/src/core/WallpaperEngine/Scripting/Adapters/ScriptableObjectAdapter.cpp
@@ -18,6 +18,8 @@ struct OpaqueScriptableObjectAdapter {
     WallpaperEngine::Scripting::ScriptableObject& object;
 };
 
+void scriptableobject_finalizer (JSRuntime* rt, JSValueConst val);
+
 JSValue scriptableobject_property_get (JSContext* ctx, JSValueConst obj_val, JSAtom atom, JSValueConst receiver) {
     JSClassID classId = 0;
 
@@ -70,6 +72,7 @@ ScriptableObjectAdapter::ScriptableObjectAdapter (ScriptEngine& engine, std::str
     this->registerType (
 	{
 	    .class_name = m_name.c_str (),
+	    .finalizer = scriptableobject_finalizer,
 	    .exotic = &m_exoticMethods,
 	}
     );
@@ -85,6 +88,18 @@ JSValue ScriptableObjectAdapter::instantiate (ScriptableObject& object) {
     return result;
 }
 
+void scriptableobject_finalizer (JSRuntime* rt, JSValueConst val) {
+    JSClassID classId = 0;
+
+    const auto* container = static_cast<OpaqueScriptableObjectAdapter*> (JS_GetAnyOpaque (val, &classId));
+
+    if (container == nullptr || container->magic != SCRIPTABLE_OPAQUE_MAGIC) {
+	return;
+    }
+
+    delete container;
+}
+
 JSValue ScriptableObjectAdapter::instantiate (DynamicValue& value) {
     throw std::runtime_error ("Cannot create a ScriptableObject instance from a DynamicValue");
 }
