From b5c34f4f10bbde832ff036ddc6fed8498a345d2e Mon Sep 17 00:00:00 2001
From: Rain <71408779+Jarod-Rain@users.noreply.github.com>
Date: Tue, 27 Oct 2026 22:01:09 -0400
Subject: [PATCH 09/21] fix: use resolved object size for effect FBO creation
 (#613)

(cherry picked from commit bbd59c01c6852f5cf7560cbfce428bb064a58629)

Origin: upstream-PR
Upstream-PR: https://github.com/Almamu/linux-wallpaperengine/pull/613
Adapted-by: livepaper
Why: effect FBOs of a fullscreen/solid/explicitly-sized image were sized from its texture, not its resolved size
Status: upstream: merged on Almamu/linux-wallpaperengine main 2026-10-28, not (yet) on next-v2
---
 src/core/WallpaperEngine/Render/Objects/CImage.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/core/WallpaperEngine/Render/Objects/CImage.cpp b/src/core/WallpaperEngine/Render/Objects/CImage.cpp
index d3d62fd..a5586cd 100644
--- a/src/core/WallpaperEngine/Render/Objects/CImage.cpp
+++ b/src/core/WallpaperEngine/Render/Objects/CImage.cpp
@@ -1118,6 +1118,9 @@ void CImage::updateScreenSpacePosition () {
 const Image& CImage::getImage () const { return this->m_image; }
 
 glm::vec2 CImage::getSize () const {
+    if (this->m_size.x > 0.0f && this->m_size.y > 0.0f) {
+	return this->m_size;
+    }
     if (this->m_texture == nullptr) {
 	return this->getImage ().size;
     }
