From 0aa7db4740de5a57d6a7b05f9373f39da67d77f4 Mon Sep 17 00:00:00 2001
From: Kryxzort <101042137+Kryxzort@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:53:09 +0530
Subject: [PATCH 022/130] render: object alpha and colour reach the shader
 live; g_Color4 is (colour, alpha)

Two divergences from Wallpaper Engine in the per-object uniforms:

- g_Brightness, g_UserAlpha, g_Alpha, g_Color, g_Color4 and
  g_CompositeColor were registered by passing the renderable's `const T&`
  getters, which bound CPass's by-value overloads: each pass stored a copy
  taken at setup. WE uploads them from the draw context on every draw, so
  a user property, a SceneScript write or a keyframe animation of an
  object's alpha or colour never reached the shader. They now bind the
  addresses of the live values, as effect constants already did.
- g_Color4 was the colour value's own vec4: ColorBuilder's alpha 1 (or 0
  once a script wrote a Vec3). WE's is (g_Color.rgb, g_Alpha) (draw
  context case 2), and genericimage2 (with VERSION), genericimage3 and
  genericimage4, the shaders of most image layers, take the layer's
  opacity from it: a translucent layer drew opaque. CImage keeps
  (colour, alpha) in a member it refreshes on every render().

Origin: ours
Why: translucent and fading layers drew opaque, and alpha/colour changes never reached the shader, in lp-player (docs/player/spikes/we-lwe-gap-audit.md B2: E2, E3)
Status: candidate-for-upstream
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01288H8YtBieDNWXo3bvfKaP
---
 .../WallpaperEngine/Render/Objects/CImage.cpp    | 10 +++++++++-
 src/core/WallpaperEngine/Render/Objects/CImage.h |  2 ++
 .../Render/Objects/Effects/CPass.cpp             | 16 +++++++++-------
 3 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/src/core/WallpaperEngine/Render/Objects/CImage.cpp b/src/core/WallpaperEngine/Render/Objects/CImage.cpp
index 062c7b5..8877673 100644
--- a/src/core/WallpaperEngine/Render/Objects/CImage.cpp
+++ b/src/core/WallpaperEngine/Render/Objects/CImage.cpp
@@ -925,6 +925,9 @@ void CImage::render () {
 
     glColorMask (true, true, true, true);
 
+    // g_Color4 is bound to m_color4: bring it up to this frame's colour and alpha
+    static_cast<void> (this->getColor4 ());
+
     // Always update screen transform (handles rotation + parallax dynamically)
     this->updateScreenSpacePosition ();
 
@@ -964,7 +967,12 @@ const float& CImage::getAlpha () const { return this->m_image.alpha->value->getF
 
 const glm::vec3& CImage::getColor () const { return this->m_image.color->value->getVec3 (); }
 
-const glm::vec4& CImage::getColor4 () const { return this->m_image.color->value->getVec4 (); }
+const glm::vec4& CImage::getColor4 () const {
+    // WE's g_Color4 is (g_Color, g_Alpha): the colour and the layer's alpha, not the colour value's own w
+    // (ColorBuilder's 1, or 0 once a vec3 was written)
+    this->m_color4 = glm::vec4 (this->getColor (), this->getAlpha ());
+    return this->m_color4;
+}
 
 const glm::vec3& CImage::getCompositeColor () const { return this->m_image.color->value->getVec3 (); }
 
diff --git a/src/core/WallpaperEngine/Render/Objects/CImage.h b/src/core/WallpaperEngine/Render/Objects/CImage.h
index 93a4226..bc3601f 100644
--- a/src/core/WallpaperEngine/Render/Objects/CImage.h
+++ b/src/core/WallpaperEngine/Render/Objects/CImage.h
@@ -128,6 +128,8 @@ private:
     glm::vec2 m_size = {};
 
     bool m_initialized = false;
+    /** (color.rgb, alpha) for g_Color4, refreshed by getColor4 () — every render () */
+    mutable glm::vec4 m_color4 = glm::vec4 (1.0f);
 
     struct {
 	struct {
diff --git a/src/core/WallpaperEngine/Render/Objects/Effects/CPass.cpp b/src/core/WallpaperEngine/Render/Objects/Effects/CPass.cpp
index c6e373b..453453d 100644
--- a/src/core/WallpaperEngine/Render/Objects/Effects/CPass.cpp
+++ b/src/core/WallpaperEngine/Render/Objects/Effects/CPass.cpp
@@ -858,14 +858,16 @@ void CPass::setupUniforms () {
     // lighting variables
     this->addUniform ("g_LightAmbientColor", sceneData.colors.ambient->value->getVec3 ());
     this->addUniform ("g_LightSkylightColor", sceneData.colors.skylight->value->getVec3 ());
-    // register variables like brightness and alpha with some default value
-    this->addUniform ("g_Brightness", renderable.getBrightness ());
-    this->addUniform ("g_UserAlpha", renderable.getUserAlpha ());
-    this->addUniform ("g_Alpha", renderable.getAlpha ());
-    this->addUniform ("g_Color", renderable.getColor ());
-    this->addUniform ("g_Color4", renderable.getColor4 ());
+    // the object's brightness, alpha and colour, bound to the live values: WE uploads them on every draw, so
+    // keyframe animations, user properties and scripts reach the shader (taking the references' addresses —
+    // passing the `const T&` itself picked the by-value overloads, which froze them at setup)
+    this->addUniform ("g_Brightness", &renderable.getBrightness ());
+    this->addUniform ("g_UserAlpha", &renderable.getUserAlpha ());
+    this->addUniform ("g_Alpha", &renderable.getAlpha ());
+    this->addUniform ("g_Color", &renderable.getColor ());
+    this->addUniform ("g_Color4", &renderable.getColor4 ());
     if (!this->m_uniforms.contains ("g_CompositeColor")) {
-	this->addUniform ("g_CompositeColor", renderable.getCompositeColor ());
+	this->addUniform ("g_CompositeColor", &renderable.getCompositeColor ());
     }
     // add some external variables
     this->addUniform ("g_Time", &this->getContext ().getContext ().renderTime);
