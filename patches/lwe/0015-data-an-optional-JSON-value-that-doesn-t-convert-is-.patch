From 639988244c7f8c0dedeac4df06ae3b8d4168464c Mon Sep 17 00:00:00 2001
From: Kryxzort <virajslko@gmail.com>
Date: Wed, 28 Oct 2026 22:10:33 +0530
Subject: [PATCH 15/17] data: an optional JSON value that doesn't convert is
 absent, not a terminate
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

JsonExtensions::optional (key) and optional (key, default) are noexcept, but
the conversion inside them throws for a value of the wrong type
(nlohmann type_error 302) or a malformed vector string (VectorBuilder). An
exception leaving a noexcept function calls std::terminate, so one odd field
in a scene aborted the whole process at load time — the try/catch around
wp_project_load_folder never saw it.

Such a value is now treated as absent (the default, or std::nullopt) with
an error line naming the key and the JSON, which is what an optional field
means. Required fields (require) still throw into the C API's catch, as
before. Also stop copying the whole JSON object on every lookup.

Found with text objects writing "padding" as a "x y" string (#652 fixes
that field, this keeps the next such field from killing the process).

Origin: ours
Why: a scene with one unexpected optional field crashed lp-player's scene worker with SIGABRT at every load (scene corpus: 3233141951, 3326873240)
Status: candidate-for-upstream
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/core/WallpaperEngine/Data/JSON.h | 25 +++++++++++++++++++++----
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/src/core/WallpaperEngine/Data/JSON.h b/src/core/WallpaperEngine/Data/JSON.h
index 2887352..13fdd09 100644
--- a/src/core/WallpaperEngine/Data/JSON.h
+++ b/src/core/WallpaperEngine/Data/JSON.h
@@ -88,25 +88,42 @@ public:
 
 	return result;
     }
+    /**
+     * An optional value whose JSON doesn't convert to T (a wrong type, a malformed vector string) is treated as
+     * absent, with a log line: these are noexcept, so a conversion error escaping them would terminate the
+     * process instead of failing (or loading) the project
+     */
     template <typename T> [[nodiscard]] std::optional<T> optional (const std::string& key) const noexcept {
-	auto base = this->base ();
+	const auto& base = this->base ();
 	const auto it = base.find (key);
 
 	if (it == base.end () || it->is_null ()) {
 	    return std::nullopt;
 	}
 
-	return *it;
+	try {
+	    std::optional<T> value = *it;
+	    return value;
+	} catch (const std::exception& e) {
+	    sLog.error ("Ignoring \"", key, "\": ", it->dump (), " (", e.what (), ")");
+	    return std::nullopt;
+	}
     }
     template <typename T> [[nodiscard]] T optional (const std::string& key, T defaultValue) const noexcept {
-	auto base = this->base ();
+	const auto& base = this->base ();
 	const auto it = base.find (key);
 
 	if (it == base.end () || it->is_null ()) {
 	    return defaultValue;
 	}
 
-	return (*it);
+	try {
+	    T value = *it;
+	    return value;
+	} catch (const std::exception& e) {
+	    sLog.error ("Ignoring \"", key, "\": ", it->dump (), " (", e.what (), "), using the default");
+	    return defaultValue;
+	}
     }
     [[nodiscard]] UserSettingUniquePtr user (const std::string& key, const Properties& properties) const;
     template <typename T>
