     /** the sound objects, ticked on the host's clock every frame (they don't render) */
     std::vector<Objects::CSound*> m_sounds = {};
     std::vector<DynamicValue*> m_scriptedValues = {};
+    std::mt19937 m_particleRng;
     glm::vec2 m_mousePosition = {};
