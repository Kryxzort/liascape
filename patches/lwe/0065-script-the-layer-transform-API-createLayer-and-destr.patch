+/** a glm matrix as the 16 numbers of SceneScript's Mat4.m (column-major, as glm keeps it) */
+JSValue matrixArray (JSContext* ctx, const glm::mat4& m) {
+    JSValue result = JS_NewArray (ctx);
+    const float* f = &m[0][0];
