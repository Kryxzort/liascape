@@ -8,6 +8,92 @@
 #include "WallpaperEngine/Assets/AssetLoadException.h"
 #include "WallpaperEngine/Context.h"
 #include "WallpaperEngine/Data/Parsers/TextureParser.h"
+#include "WallpaperEngine/Logging/Log.h"
