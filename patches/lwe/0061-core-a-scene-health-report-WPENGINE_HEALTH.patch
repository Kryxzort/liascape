diff --git a/src/core/WallpaperEngine/Health.cpp b/src/core/WallpaperEngine/Health.cpp
new file mode 100644
index 0000000..68f1f8d
--- /dev/null
+++ b/src/core/WallpaperEngine/Health.cpp
@@ -0,0 +1,115 @@
+#include "Health.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace WallpaperEngine::Health {
+namespace {
+std::atomic<bool> g_enabled { false };
+std::mutex g_mutex;
+FILE* g_file = nullptr;
+std::string g_path;
+std::unordered_set<std::string> g_written;
+size_t g_lines = 0;
+/** a runaway (a script erroring with a new message every frame) can't fill the disk */
+constexpr size_t kMaxLines = 50000;
+
+thread_local std::vector<std::pair<std::string, nlohmann::json>> t_scopes;
+} // namespace
+
+void configure () noexcept {
+    std::lock_guard lock (g_mutex);
+    const char* env = std::getenv ("WPENGINE_HEALTH");
+    const std::string path = env != nullptr ? env : "";
+
+    if (path == g_path && (g_file != nullptr || path.empty ())) {
+	return;
+    }
+    if (g_file != nullptr) {
+	std::fclose (g_file);
+	g_file = nullptr;
+    }
+    g_written.clear ();
+    g_lines = 0;
+    g_path = path;
+    if (!path.empty ()) {
+	g_file = std::fopen (path.c_str (), "a");
+    }
+    g_enabled.store (g_file != nullptr, std::memory_order_relaxed);
+}
+
+bool enabled () noexcept { return g_enabled.load (std::memory_order_relaxed); }
+
+void report (const char* event, nlohmann::json fields) noexcept {
+    if (!enabled ()) {
+	return;
+    }
+    try {
+	nlohmann::json record = nlohmann::json::object ();
+	record["ev"] = event;
+	for (const auto& [key, value] : t_scopes) {
+	    record[key] = value;
+	}
+	if (fields.is_object ()) {
+	    for (auto& [key, value] : fields.items ()) {
+		record[key] = value;
+	    }
+	}
+	// invalid UTF-8 in a message (a font name, a shader log) is replaced, not thrown
+	std::string line = record.dump (-1, ' ', false, nlohmann::json::error_handler_t::replace);
+
+	std::lock_guard lock (g_mutex);
+	if (g_file == nullptr || g_lines >= kMaxLines || !g_written.insert (line).second) {
+	    return;
+	}
+	g_lines++;
+	line += '\n';
+	std::fwrite (line.data (), 1, line.size (), g_file);
+	std::fflush (g_file);
+    } catch (...) {
+	// a health record never breaks the renderer
+    }
+}
+
+Scope::Scope (const char* key, int value) noexcept {
+    if (enabled ()) {
+	try {
+	    t_scopes.emplace_back (key, value);
+	    m_pushed = true;
+	} catch (...) {
+	}
+    }
+}
+
+Scope::Scope (const char* key, const std::string& value) noexcept {
+    if (enabled ()) {
+	try {
+	    t_scopes.emplace_back (key, value);
+	    m_pushed = true;
+	} catch (...) {
+	}
+    }
+}
+
+Scope::~Scope () {
+    if (m_pushed && !t_scopes.empty ()) {
+	t_scopes.pop_back ();
+    }
+}
+
+std::string brief (const std::string& message, size_t max) {
+    std::string out = message.substr (0, message.find ("Compiled source code:"));
+    while (!out.empty () && (out.back () == '\n' || out.back () == ' ')) {
+	out.pop_back ();
+    }
+    if (out.size () > max) {
+	out = out.substr (0, max) + "…";
+    }
+    return out;
+}
+} // namespace WallpaperEngine::Health
diff --git a/src/core/WallpaperEngine/Health.h b/src/core/WallpaperEngine/Health.h
new file mode 100644
index 0000000..f260dbb
--- /dev/null
+++ b/src/core/WallpaperEngine/Health.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <string>
+
+#include <nlohmann/json.hpp>
+
+/**
+ * Scene health: what the core built, what it left out and why, as JSON lines.
+ *
+ * Off unless `WPENGINE_HEALTH=<path>` is set when a project loads (`wp_project_load_*`): then every record below is
+ * appended to that file, one JSON object per line, `{"ev": <event>, …}`, plus the keys of the scopes open on this
+ * thread (`object`, `object_name`, `effect`, `shader`, …) so an error deep in a shader compile names its layer.
+ * Identical lines are written once. Nothing the renderer does depends on it: each call site is
+ * `WPENGINE_HEALTH (…)`, one load of a bool when it is off.
+ *
+ * Events: `scene` (size, object count), `object` (one per scene object after the build: id, name, type, parent,
+ * built), `dropped` (an object not built, its reason), `effect_dropped`, `shader_error` (glslang / GL compile or
+ * link), `missing_asset` (kind: texture, font, model, puppet, particle, material, sound, shader_module), `script_error`
+ * (the script's key, object, property, phase), `unsupported` (a feature LWE logs as not supported), `compat` (an
+ * HLSL-lenient rewrite or a case-insensitive file match — informational), `layers` (per drawable at render frames 1
+ * and 31: effective visibility, alpha, canvas bbox, non-finite transforms), `load_failed`, `renderer_failed`.
+ */
+namespace WallpaperEngine::Health {
+/** Reads `WPENGINE_HEALTH` and opens (or closes) the output; called when a project loads */
+void configure () noexcept;
+/** True while `WPENGINE_HEALTH` named a file that opened */
+[[nodiscard]] bool enabled () noexcept;
+/** Appends `{"ev": event, <open scopes>, <fields>}` (fields win over scopes); a no-op when off */
+void report (const char* event, nlohmann::json fields = nlohmann::json::object ()) noexcept;
+
+/** A key every record on this thread carries until the scope closes (nests; an inner key shadows) */
+class Scope {
+public:
+    Scope (const char* key, int value) noexcept;
+    Scope (const char* key, const std::string& value) noexcept;
+    ~Scope ();
+    Scope (const Scope&) = delete;
+    Scope& operator= (const Scope&) = delete;
+
+private:
+    bool m_pushed = false;
+};
+
+/** The first `max` bytes of a log message, without a "Compiled source code:" dump */
+[[nodiscard]] std::string brief (const std::string& message, size_t max = 600);
+} // namespace WallpaperEngine::Health
+
+#define WPENGINE_HEALTH(...)                                                                                           \
+    do {                                                                                                               \
+	if (::WallpaperEngine::Health::enabled ()) {                                                                   \
+	    ::WallpaperEngine::Health::report (__VA_ARGS__);                                                           \
+	}                                                                                                              \
+    } while (0)
