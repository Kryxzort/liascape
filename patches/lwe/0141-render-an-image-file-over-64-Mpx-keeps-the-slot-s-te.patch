From 0011f3dffba812f574cb5f0f1ea9b123cabec7f5 Mon Sep 17 00:00:00 2001
From: Kryxzort <101042137+Kryxzort@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:18:58 +0530
Subject: [PATCH 141/143] render: an image file over 64 Mpx keeps the slot's
 texture, and none is read past the cap

The per-side cap still let an image decode to 16384 x 16384 = 268 Mpx, 1 GiB as RGBA8 in the worker and again as a GL
texture, from a flat PNG of under 1 MiB on disk; a preset can fill every image slot of its scene, so one download could
ask for several GiB. imageFileTexture now also refuses an image whose header says more than 8192 x 8192 = 64 Mpx
(256 MiB decoded; an 8K image is 33 Mpx), checked from stb's header read before anything decodes, 64-bit product.

The file is now read from the open stream in 64 KiB chunks and refused once it passes 64 MiB, so a file that grows
after the size check (a download still landing) is never read whole; a file whose size can't be read says so
("Cannot size image file") rather than "over 64 MiB".

Tested by liascape's host_api_test usertexture_caps_an_image_file: a zlib-compressed solid 8193 x 8192 PNG (916 KB)
keeps util/white, an 8192 x 8192 one loads; red on 1656c24 (the 8193 x 8192 image took the slot: 200 40 10).

Origin: ours
Why: liascape docs/TODO.md #108 (preset wallpapers: a preset's own images)
Status: candidate-for-upstream
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vg3T4kUDe36Q9Hthaz2WEU
---
 .../WallpaperEngine/Render/RenderContext.cpp  | 45 +++++++++++++++----
 1 file changed, 37 insertions(+), 8 deletions(-)

diff --git a/src/core/WallpaperEngine/Render/RenderContext.cpp b/src/core/WallpaperEngine/Render/RenderContext.cpp
index 692f661..da7ca44 100644
--- a/src/core/WallpaperEngine/Render/RenderContext.cpp
+++ b/src/core/WallpaperEngine/Render/RenderContext.cpp
@@ -13,16 +13,23 @@
 #include <stb_image.h>
 
 #include <algorithm>
+#include <array>
 #include <cctype>
+#include <cstdint>
 #include <fstream>
 #include <iterator>
 
 namespace {
 using namespace WallpaperEngine::Data::Assets;
 
-/** The largest image file read for a texture name that is an image path, and the largest side it may decode to. */
+/**
+ * The largest image file read for a texture name that is an image path, the largest side it may decode to, and the most
+ * pixels it may decode to (8192², 256 MiB as RGBA8: an 8K image fits; a flat 16384² PNG of under 1 MiB would be 1 GiB,
+ * and a preset can fill every image slot of its scene).
+ */
 constexpr std::uintmax_t MAX_IMAGE_FILE_BYTES = std::uintmax_t (64) << 20;
 constexpr int MAX_IMAGE_SIDE = 16384;
+constexpr std::uint64_t MAX_IMAGE_PIXELS = std::uint64_t (8192) * 8192;
 
 /**
  * The image format of a texture name the host set to an image file's absolute path (a scenetexture property set to a
@@ -58,9 +65,10 @@ FIF imageFileFormat (const std::string& name) {
  * The image file as the texture a .tex wrapping a PNG / JPEG is (TEXB0003 with a FreeImage format): one image, one level
  * holding the file's bytes, decoded to RGBA8 by stb_image when it uploads (a GIF's first frame), its size its own (no
  * power-of-two padding, so an image object's UVs stay whole) and clamped at the edges as WE's image textures are. Throws
- * AssetLoadException for a file that can't be read, isn't an image stb_image knows, or is past the caps (a file over
- * MAX_IMAGE_FILE_BYTES is never read, an image over MAX_IMAGE_SIDE a side never decoded: any absolute image path takes
- * this route, so a size is no promise), which every caller reports and survives by keeping the slot's own texture.
+ * AssetLoadException for a file that can't be read, isn't an image stb_image knows, or is past the caps (no more than
+ * MAX_IMAGE_FILE_BYTES is ever read, an image over MAX_IMAGE_SIDE a side or MAX_IMAGE_PIXELS is never decoded: any
+ * absolute image path takes this route, so a size is no promise), which every caller reports and survives by keeping
+ * the slot's own texture.
  */
 TextureUniquePtr imageFileTexture (const std::string& path, FIF format) {
     std::ifstream file (path, std::ios::binary);
@@ -69,13 +77,29 @@ TextureUniquePtr imageFileTexture (const std::string& path, FIF format) {
 	    "Cannot read image file", path, std::make_error_code (std::errc::no_such_file_or_directory)
 	);
     }
-    std::error_code sizeError;
-    if (const auto size = std::filesystem::file_size (path, sizeError); sizeError || size > MAX_IMAGE_FILE_BYTES) {
-	throw WallpaperEngine::Assets::AssetLoadException (
+    const auto tooLarge = [&path] () {
+	return WallpaperEngine::Assets::AssetLoadException (
 	    "Image file over 64 MiB", path, std::make_error_code (std::errc::file_too_large)
 	);
+    };
+    std::error_code sizeError;
+    const auto size = std::filesystem::file_size (path, sizeError);
+    if (sizeError) {
+	throw WallpaperEngine::Assets::AssetLoadException ("Cannot size image file", path, sizeError);
+    }
+    if (size > MAX_IMAGE_FILE_BYTES) {
+	throw tooLarge ();
+    }
+    // read from the open file, never past the cap: it can still grow after the size check (a download landing)
+    std::vector<char> bytes;
+    bytes.reserve (static_cast<size_t> (size));
+    std::array<char, 1 << 16> chunk {};
+    while (file.read (chunk.data (), chunk.size ()) || file.gcount () > 0) {
+	bytes.insert (bytes.end (), chunk.data (), chunk.data () + file.gcount ());
+	if (bytes.size () > MAX_IMAGE_FILE_BYTES) {
+	    throw tooLarge ();
+	}
     }
-    std::vector<char> bytes ((std::istreambuf_iterator<char> (file)), std::istreambuf_iterator<char> ());
     int width = 0, height = 0, channels = 0;
     if (bytes.empty () || bytes.size () > static_cast<size_t> (INT32_MAX)
 	|| !stbi_info_from_memory (
@@ -91,6 +115,11 @@ TextureUniquePtr imageFileTexture (const std::string& path, FIF format) {
 	    "Image over 16384 px a side", path, std::make_error_code (std::errc::value_too_large)
 	);
     }
+    if (static_cast<std::uint64_t> (width) * static_cast<std::uint64_t> (height) > MAX_IMAGE_PIXELS) {
+	throw WallpaperEngine::Assets::AssetLoadException (
+	    "Image over 64 Mpx", path, std::make_error_code (std::errc::value_too_large)
+	);
+    }
 
     auto mipmap = std::make_shared<Mipmap> ();
     mipmap->width = static_cast<uint32_t> (width);
