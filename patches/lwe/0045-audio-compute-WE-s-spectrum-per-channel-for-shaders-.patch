+const float* PlaybackRecorder::bands (int resolution, int channel) const {
+    if (channel < 0 || channel > 2) {
+	return nullptr;
+    }
+    switch (resolution) {
+	case 16:
+	    return this->audio16 [channel];
+	case 32:
+	    return this->audio32 [channel];
+	case 64:
+	    return this->audio64 [channel];
+	default:
