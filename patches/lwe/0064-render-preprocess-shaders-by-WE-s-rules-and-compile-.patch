+    std::vector<std::vector<std::string>> chains; // the open #if chains, outermost first
+    std::vector<size_t> chainStart;               // the line each chain's #if is on
+    int braces = 0, parens = 0;
+    bool block = false;
+    long hoistAt = -1;
+    std::set<std::string> definedSince;
+    std::string hoisted;
+    size_t moved = 0;
