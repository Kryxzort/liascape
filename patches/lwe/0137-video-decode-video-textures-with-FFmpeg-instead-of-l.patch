diff --git a/src/core/WallpaperEngine/VideoPlayback/CudaGL.cpp b/src/core/WallpaperEngine/VideoPlayback/CudaGL.cpp
new file mode 100644
index 0000000..02c72f0
--- /dev/null
+++ b/src/core/WallpaperEngine/VideoPlayback/CudaGL.cpp
@@ -0,0 +1,33 @@
+#include "CudaGL.h"
+
+#include <dlfcn.h>
+#include <type_traits>
+
+using namespace WallpaperEngine::VideoPlayback;
+
+const CudaGL* CudaGL::get () {
+    static const CudaGL* calls = [] () -> const CudaGL* {
+	// by soname only: a libcuda already in the process (FFmpeg's, or the host's) is found whatever its path
+	void* lib = dlopen ("libcuda.so.1", RTLD_NOW | RTLD_LOCAL);
+	if (lib == nullptr) {
+	    return nullptr;
+	}
+	static CudaGL c {};
+	bool all = true;
+	auto bind = [&] (auto& slot, const char* name) {
+	    void* f = dlsym (lib, name);
+	    all = all && f != nullptr;
+	    slot = reinterpret_cast<std::remove_reference_t<decltype (slot)>> (f);
+	};
+	bind (c.ctxPushCurrent, "cuCtxPushCurrent_v2");
+	bind (c.ctxPopCurrent, "cuCtxPopCurrent_v2");
+	bind (c.graphicsGLRegisterImage, "cuGraphicsGLRegisterImage");
+	bind (c.graphicsUnregisterResource, "cuGraphicsUnregisterResource");
+	bind (c.graphicsMapResources, "cuGraphicsMapResources");
+	bind (c.graphicsUnmapResources, "cuGraphicsUnmapResources");
+	bind (c.graphicsSubResourceGetMappedArray, "cuGraphicsSubResourceGetMappedArray");
+	bind (c.memcpy2DAsync, "cuMemcpy2DAsync_v2");
+	return all ? &c : nullptr;
+    }();
+    return calls;
+}
diff --git a/src/core/WallpaperEngine/VideoPlayback/CudaGL.h b/src/core/WallpaperEngine/VideoPlayback/CudaGL.h
new file mode 100644
index 0000000..860869b
--- /dev/null
+++ b/src/core/WallpaperEngine/VideoPlayback/CudaGL.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstddef>
+
+namespace WallpaperEngine::VideoPlayback {
+/**
+ * The few libcuda calls that copy a decoded CUDA frame into GL textures (CUDA–GL interop), looked up in the process's
+ * libcuda: FFmpeg's CUDA device already loaded it by soname (and a host that wants the interop loads it before, from
+ * wherever its driver lives). Declared here rather than from cuda.h, which no build dependency ships.
+ */
+struct CudaGL {
+    using CUresult = int;
+    using CUcontext = void*;
+    using CUstream = void*;
+    using CUgraphicsResource = void*;
+    using CUarray = void*;
+    using CUdeviceptr = unsigned long long;
+
+    static constexpr unsigned kRegisterWriteDiscard = 2; // CU_GRAPHICS_REGISTER_FLAGS_WRITE_DISCARD
+    static constexpr int kMemoryDevice = 2;		 // CU_MEMORYTYPE_DEVICE
+    static constexpr int kMemoryArray = 3;		 // CU_MEMORYTYPE_ARRAY
+
+    /** CUDA_MEMCPY2D (cuda.h, the _v2 layout) */
+    struct Memcpy2D {
+	size_t srcXInBytes;
+	size_t srcY;
+	int srcMemoryType;
+	const void* srcHost;
+	CUdeviceptr srcDevice;
+	CUarray srcArray;
+	size_t srcPitch;
+	size_t dstXInBytes;
+	size_t dstY;
+	int dstMemoryType;
+	void* dstHost;
+	CUdeviceptr dstDevice;
+	CUarray dstArray;
+	size_t dstPitch;
+	size_t WidthInBytes;
+	size_t Height;
+    };
+
+    CUresult (*ctxPushCurrent) (CUcontext);
+    CUresult (*ctxPopCurrent) (CUcontext*);
+    CUresult (*graphicsGLRegisterImage) (CUgraphicsResource*, unsigned image, unsigned target, unsigned flags);
+    CUresult (*graphicsUnregisterResource) (CUgraphicsResource);
+    CUresult (*graphicsMapResources) (unsigned count, CUgraphicsResource*, CUstream);
+    CUresult (*graphicsUnmapResources) (unsigned count, CUgraphicsResource*, CUstream);
+    CUresult (*graphicsSubResourceGetMappedArray) (CUarray*, CUgraphicsResource, unsigned index, unsigned level);
+    CUresult (*memcpy2DAsync) (const Memcpy2D*, CUstream);
+
+    /** the calls, or null when the process has no libcuda or it lacks one of them */
+    static const CudaGL* get ();
+};
